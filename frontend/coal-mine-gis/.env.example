# Public, client-safe configuration only.
# NEVER put MQTT broker credentials, database credentials, InfluxDB tokens,
# Twilio/SendGrid keys, or any private API secret in this file or anywhere
# in the frontend. Those belong exclusively on the backend/gateway.

# Base URL of the backend REST API that will eventually replace mock data
# (see src/services/apiService.js). Leave blank to keep running in demo mode.
VITE_API_BASE_URL=

# Optional: base URL for a WebSocket/SSE stream of live sensor data.
VITE_WS_URL=

# Nominatim (OpenStreetMap) geocoding is used by default and requires no key.
# If you later swap in a commercial geocoder, put its public client key here.
VITE_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# Overpass API endpoint used for public road/rail/waterway context.
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
